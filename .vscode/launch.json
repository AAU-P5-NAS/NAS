{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Module",
            "type": "debugpy",
            "request": "launch",
            "module": "main",
            "args": [
                "--report-exception"
            ]
        },
        {
            "name": "Python Debugger: Typst Master",
            "type": "debugpy",
            "request": "launch",
            "module": "src.utils.typst.master",
            "args": [
                // positional arguments:
                // output                Name of output file

                // options:
                // -h, --help            show this help message and exit
                // --experiments EXPERIMENTS [EXPERIMENTS ...] Name of experiments to include
                // --y Y                 Name of metric to plot on y-axis
                // --resolution RESOLUTION
                //                         Downsample factor
                // --smooth SMOOTH       Smoothing factor
                // --xmin XMIN           X minimum
                // --xmax XMAX           X maximum
                // --ymin YMIN           Y minimum
                // --ymax YMAX           Y maximum
                "output",
                "--experiments", "exp1",
                "--y", "accuracy",
                "--resolution", "1",
                "--smooth", "5",
                "--xmin", "0",
                "--xmax", "100",
                "--ymin", "0",
                "--ymax", "1"
            ]
        }
    ]
}